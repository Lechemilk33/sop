<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>My Story</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.lifestyle</string>
	<key>MyStoryCloudKitContainer</key>
	<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>MyStoryICloudSync</key>
	<string>$(MYSTORY_ICLOUD_SYNC)</string>
	<key>NSCameraUsageDescription</key>
	<string>My Story uses the camera so the family can take a photo of someone for My people.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>My Story uses the microphone to record stories in your own voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>My Story writes down stories on this iPhone so the family can read along. Nothing is sent anywhere.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportsFullScreenInAssistiveAccess</key>
	<true/>
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
